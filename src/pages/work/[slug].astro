---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import Lightbox from '../../components/ui/Lightbox.astro';
import MetricList from '../../components/ui/MetricList.astro';
import PipelineDiagram from '../../components/ui/PipelineDiagram.astro';
import ProjectMedia from '../../components/ui/ProjectMedia.astro';
import { formatMonth, getFeatured, type Project } from '../../lib/content';
import { getMap } from '../../lib/map';

export async function getStaticPaths() {
  const featured = await getFeatured();
  return featured.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: featured[(i + 1) % featured.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}
const { project, next } = Astro.props;
const data = project.data;
// One template for every project. The Markdown body is free text; without one, the description is
// the text. Metrics and the pipeline show only when the project has them.
const hasBody = Boolean(project.body?.trim());
const { Content } = await render(project);
const map = await getMap();

const STATUS = { 'in-progress': 'In progress', shipped: 'Shipped', course: 'Course project' } as const;
const period = data.period
  ? data.period.end
    ? `${formatMonth(data.period.start)} - ${data.period.end === 'present' ? 'present' : formatMonth(data.period.end)}`
    : formatMonth(data.period.start)
  : undefined;
const meta = [
  { term: 'Role', value: data.role },
  { term: 'Period', value: period },
  { term: 'Status', value: STATUS[data.status] },
  { term: 'Context', value: data.context },
].filter((item): item is { term: string; value: string } => Boolean(item.value));
const hasLinks = Boolean(data.links.repo || data.links.demo || data.links.paper);
---
<BaseLayout title={`${data.title} · Michael Geraldin Wijaya`} description={data.summary}>
  <article class="case wrap">
    <a class="back" href="/#projects"><Icon name="arrow-left" /><span>Back to projects</span></a>

    <header class="case-head">
      <div class="head-text">
        <h1 class="t-case" style={`view-transition-name: work-${project.id}`}>{data.title}</h1>
        <p class="t-lead t-muted">{data.summary}</p>
        <dl class="meta">
          {meta.map((item) => (
            <div>
              <dt class="t-small t-muted">{item.term}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <!-- The card's picture: its cover opens larger, its map view is the same as on the card. -->
      <ProjectMedia
        project={project}
        map={map}
        sizes="(min-width: 1024px) 480px, calc(100vw - 2 * var(--gutter))"
        alt={data.coverAlt ?? ''}
        zoom
        priority
      />
    </header>

    {data.metrics && data.metrics.length > 0 && (
      <section class="results" aria-label="Results">
        <MetricList metrics={data.metrics} />
      </section>
    )}

    <!-- The pipeline comes first, so phones see it before the text; wide screens put it beside. -->
    <div class="case-body">
      {data.pipeline && (
        <aside class="case-aside" aria-label="System pipeline">
          <PipelineDiagram stages={data.pipeline} label="How a request moves through the system." />
        </aside>
      )}
      <div class="prose">
        {hasBody ? <Content /> : <p>{data.description}</p>}

        <section>
          <h2>Stack</h2>
          {Object.keys(data.stack).length > 0 ? (
            <dl class="stack">
              {Object.entries(data.stack).map(([group, tools]) => (
                <div>
                  <dt>{group}</dt>
                  <dd>{tools.map((tool, i) => <>{i > 0 && ', '}<span class="id" translate="no">{tool}</span></>)}</dd>
                </div>
              ))}
            </dl>
          ) : (
            <p class="tools">{data.tags.map((tag, i) => <>{i > 0 && ', '}<span class="id" translate="no">{tag}</span></>)}</p>
          )}
        </section>

        <section>
          <h2>Links</h2>
          {hasLinks ? (
            <ul class="links">
              {data.links.repo && <li><a href={data.links.repo}>Source code on GitHub</a></li>}
              {data.links.demo && <li><a href={data.links.demo}>Live demo</a></li>}
              {data.links.paper && <li><a href={data.links.paper}>Paper</a></li>}
            </ul>
          ) : (
            <p class="t-muted">{data.confidential ? 'Code is private: client work.' : 'No public links yet.'}</p>
          )}
        </section>
      </div>
    </div>

    <nav class="next" aria-label="Next project">
      <span class="t-small t-muted">Next project</span>
      <a href={`/work/${next.id}`} class="t-h3"><span>{next.data.title}</span><Icon name="arrow-right" /></a>
    </nav>
  </article>
  <Lightbox />
</BaseLayout>

<style>
  .case { padding-block: 32px 96px; display: grid; gap: 48px; }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    width: fit-content;
    font-weight: 600;
    text-decoration: none;
  }
  .back:hover span { text-decoration: underline; text-underline-offset: 0.2em; }
  .case-head { display: grid; gap: 32px; }
  .head-text { display: grid; gap: 20px; align-content: start; max-width: 900px; }
  @media (min-width: 1024px) {
    .case-head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: center; column-gap: 56px; }
  }
  .case-head :global(.media) { border-radius: var(--radius-frame); box-shadow: inset 0 0 0 1px var(--hair); }
  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 16px 32px;
    margin: 8px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--hair);
  }
  .meta dd { margin: 4px 0 0; font-weight: 600; }

  .results {
    padding: 24px 28px;
    border-radius: var(--radius-frame);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--hair);
  }

  .case-body { display: grid; gap: 48px; }
  @media (min-width: 1024px) {
    .case-body:has(> .case-aside) { grid-template-columns: 7fr 5fr; align-items: start; }
    .case-body > .prose { grid-column: 1; grid-row: 1; }
    .case-aside { grid-column: 2; grid-row: 1; position: sticky; top: calc(var(--header-h) + 24px); }
  }

  .prose { display: grid; gap: 20px; max-width: 66ch; }
  .prose :global(h2) {
    font-size: clamp(1.25rem, 1.162rem + 0.376vw, 1.5rem);
    font-weight: 650;
    letter-spacing: -0.01em;
    margin-top: 16px;
  }
  .prose :global(p) { color: var(--ink); }
  .prose :global(img) { border-radius: var(--radius-frame); }
  .prose :global(a.zoom) { cursor: zoom-in; }
  .prose section { display: grid; gap: 14px; }

  .stack { display: grid; gap: 14px; margin: 0; }
  .stack dt { font-weight: 600; }
  .stack dd { margin: 4px 0 0; }
  /* Names can contain spaces, so each stays whole and commas separate them. */
  .stack .id,
  .tools .id { white-space: nowrap; }
  .links { display: grid; gap: 8px; padding-left: 1.2em; }

  .next {
    display: grid;
    gap: 6px;
    padding-top: 32px;
    border-top: 1px solid var(--hair);
  }
  .next a { display: inline-flex; align-items: center; gap: 10px; width: fit-content; color: var(--ink); text-decoration: none; }
  .next a :global(.icon) { color: var(--link); }
  .next a:hover { color: var(--link); }
  .next a:hover span { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.18em; }
</style>
