---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---
<BaseLayout
  title="Page not found | Michael Geraldin Wijaya"
  description="This page does not exist. The portfolio of Michael Geraldin Wijaya, AI engineer, is on the home page."
  noindex
>
  <section class="missing wrap" aria-labelledby="missing-title">
    <h1 id="missing-title" class="t-hero">Page not found</h1>
    <!-- A light touch, from the work on this site (the agent that searches documents, a database, and
         the web), then the plain reason. The emoji is decoration: screen readers skip it. -->
    <p class="t-lead t-muted">
      I sent my agent to find this page, and it came back empty-handed <span aria-hidden="true">🤖</span>
    </p>
    <p class="t-muted">The link may be out of date, or the address mistyped.</p>
    <div class="actions">
      <Button href="/" variant="primary" icon="house">Go to the home page</Button>
      <Button href="/#projects" variant="secondary" icon="arrow-right">View projects</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .missing {
    display: grid;
    gap: 20px;
    align-content: center;
    min-height: calc(100dvh - var(--header-h) - 160px);
    padding-block: 64px;
  }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  @media (max-width: 479px) { .actions { display: grid; } }
</style>
