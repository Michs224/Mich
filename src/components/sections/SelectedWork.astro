---
// One card per featured project, all built the same way, so a new project needs no layout work.
import ProjectMedia from '../ui/ProjectMedia.astro';
import { DOMAIN_LABELS, getFeatured } from '../../lib/content';
import { getMap } from '../../lib/map';

const featured = await getFeatured();
const map = await getMap();
---
<section id="projects" class="section wrap" aria-labelledby="work-title">
  <h2 id="work-title" class="t-h2 section-title">Projects</h2>
  <div class="cards">
    {featured.map((project) => {
      const { id, data } = project;
      return (
        <article class="card shell" style={`--field: var(--field-${data.domain})`}>
          <div class="core">
          <ProjectMedia project={project} map={map} sizes="(min-width: 1320px) 400px, (min-width: 1024px) 31vw, (min-width: 768px) 46vw, 100vw" />
          <div class="body">
            <p class="field t-small">{DOMAIN_LABELS[data.domain]}</p>
            <h3 class="t-h3">
              <a href={`/work/${id}`} style={`view-transition-name: work-${id}`}>{data.title}</a>
            </h3>
            <p class="summary t-muted">{data.summary}</p>
            {/* The whole stack, as the old site's cards listed it (owner's request, 2026-10-25). */}
            <p class="stack">
              <span class="sr-only">Tools: </span>
              {data.tags.map((tool, i) => (
                <>{i > 0 && ', '}<span class="id" translate="no">{tool}</span></>
              ))}
            </p>
            <p class="foot">
              {data.status === 'in-progress' && <span class="status">In progress</span>}
              <span class="more" aria-hidden="true">View project</span>
            </p>
          </div>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .cards { display: grid; gap: 24px; }
  @media (min-width: 768px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  /* Two columns on tablets: an odd last card takes the whole row, its picture beside its text, so no
     cell stays empty (audit, 2026-10-25). */
  @media (min-width: 768px) and (max-width: 1023px) {
    .card:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .card:last-child:nth-child(odd) .core { flex-direction: row; }
    .card:last-child:nth-child(odd) :global(.media) { flex: 0 0 50%; }
  }

  .card { position: relative; display: flex; }
  .core { display: flex; flex: 1; flex-direction: column; overflow: hidden; }
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 14px;
    padding: 22px 24px 28px;
  }
  @media (min-width: 768px) { .body { padding: 24px 28px 32px; } }

  /* The picture leans in when the card is pointed at or focused; it answers the visitor (02 §10). */
  @media (prefers-reduced-motion: no-preference) {
    .card :global(.media > *) { transition: transform 700ms var(--ease); }
    .card:is(:hover, :focus-within) :global(.media > *) { transform: scale(1.045); }
  }
  /* Each picture uncovers from the bottom as its card scrolls in, done once the card is well in
     view; with reduced motion it fades in instead. Longhand: the minifier folds a shorthand next
     to animation-timeline. */
  @supports (animation-timeline: view()) {
    .card :global(.media) {
      animation-name: media-fade;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: entry 0% entry 70%;
    }
    @media (prefers-reduced-motion: no-preference) {
      .card :global(.media) { animation-name: media-reveal; }
    }
  }
  @keyframes media-reveal {
    from { clip-path: inset(100% 0 0 0); }
    to { clip-path: inset(0); }
  }
  @keyframes media-fade { from { opacity: 0; } }

  /* The field, in its embedding map color. */
  .field { display: flex; align-items: center; gap: 8px; color: var(--muted); }
  .field::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--field);
  }

  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  /* One link per card: its hit area covers the whole card. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  h3 a:focus-visible { outline: none; }
  .card:has(h3 a:focus-visible) { outline: 3px solid var(--focus); outline-offset: 2px; }

  .summary { max-width: 60ch; }
  /* Names can contain spaces ("AWS Bedrock"), so they are a comma-separated list that never splits a name. */
  .stack { font-size: 1rem; line-height: 1.7; }
  .stack .id { white-space: nowrap; }
  .foot { display: flex; align-items: center; gap: 16px; margin-top: auto; padding-top: 4px; font-weight: 600; }
  /* The hairline keeps the chip's shape visible on dark cards, where the tint alone barely shows. */
  .status {
    padding: 3px 10px;
    border-radius: var(--radius-control);
    background: var(--tint);
    box-shadow: inset 0 0 0 1px var(--hair);
    font-size: 0.9375rem;
  }
  .more { color: var(--link); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .card:hover .more { text-decoration-thickness: 2px; }
</style>
