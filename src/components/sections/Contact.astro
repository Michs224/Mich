---
// Contact (02 §7): the statement and email on 5/12, the form on 7/12. Field names stay Name, Email,
// and Message because the Google Sheet behind the Apps Script reads them. "leave_empty" is a
// honeypot, named so no browser autofill rule recognizes it (a field called "company" would get
// filled from a saved address and silently block a real message).
import Icon from '../ui/Icon.astro';
import { site } from '../../data/site';
---
<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="wrap grid">
    <div class="statement">
      <h2 id="contact-title" class="t-h2">Contact</h2>
      <p class="t-lead t-muted">
        I’m open to new opportunities, collaborations, and questions about any of these projects.
        Send a message, or email me directly.
      </p>
      <a class="email" href={`mailto:${site.email}`} translate="no"><Icon name="envelope-simple" /><span>{site.email}</span></a>
      <ul class="profiles">
        <li><a href={site.socials.github}><Icon name="github-logo" /><span>GitHub</span></a></li>
        <li><a href={site.socials.linkedin}><Icon name="linkedin-logo" /><span>LinkedIn</span></a></li>
      </ul>
    </div>

    <div class="shell reveal">
    <form name="contact" class="form core" method="post" action={site.formEndpoint}>
      <div class="field">
        <label for="contact-name">Name</label>
        <input id="contact-name" name="Name" type="text" autocomplete="name" required aria-describedby="contact-name-error" />
        <p id="contact-name-error" class="field-error"></p>
      </div>
      <div class="field">
        <label for="contact-email">Email</label>
        <input
          id="contact-email"
          name="Email"
          type="email"
          autocomplete="email"
          spellcheck="false"
          required
          aria-describedby="contact-email-error"
        />
        <p id="contact-email-error" class="field-error"></p>
      </div>
      <div class="field">
        <label for="contact-message">Message</label>
        <textarea id="contact-message" name="Message" rows="6" required aria-describedby="contact-message-error"></textarea>
        <p id="contact-message-error" class="field-error"></p>
      </div>
      <div class="honeypot" aria-hidden="true">
        <label for="contact-trap">Leave this field empty</label>
        <input id="contact-trap" name="leave_empty" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <div class="actions">
        <button type="submit" class="btn btn-primary">
          <span class="spinner" aria-hidden="true"></span><span class="label">Send message</span><span class="btn-icon"><Icon name="paper-plane-tilt" /></span>
        </button>
        <p class="status" role="status"></p>
      </div>
    </form>
    </div>
  </div>
  <!-- A sound landscape along the bottom on wide screens: the spectrogram of a spoken sentence
       (spectrogram/mount.ts). -->
  <canvas class="terrain" aria-hidden="true"></canvas>
</section>

<script>
  import { mountContactForm } from '../../scripts/contact-form';
  import { mountTerrain } from '../../scripts/spectrogram/mount';
  const form = document.querySelector<HTMLFormElement>('form[name="contact"]');
  if (form) mountContactForm(form);
  const terrain = document.querySelector<HTMLCanvasElement>('#contact canvas.terrain');
  if (terrain) mountTerrain(terrain);
</script>

<style>
  .grid { display: grid; gap: 40px; }
  @media (min-width: 1024px) {
    .grid { grid-template-columns: 5fr 7fr; gap: 64px; align-items: start; }
  }

  /* The sound landscape, on wide screens only. The canvas keeps the 16:9 shape the terrain is drawn
     for, so the ridges fill its lower part; the section leaves room for them under the form. It
     stays transparent until the first frame is drawn, so nothing pops in. */
  .terrain { display: none; }
  @media (min-width: 1024px) {
    .contact { position: relative; isolation: isolate; padding-bottom: 21vw; }
    .terrain {
      display: block;
      position: absolute;
      left: 0;
      bottom: 0;
      z-index: -1;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      pointer-events: none;
      opacity: 0;
      mask-image: linear-gradient(to bottom, transparent 55%, #000 80%);
    }
    .terrain:is(.is-live, .is-still) { opacity: 1; }
  }
  @media (min-width: 1024px) {
    .terrain { transition: opacity 0.9s var(--ease); }
  }

  /* Filled from 0 to 1 while the landscape scrolls into view; mount.ts reads it each frame on
     screen. Not inherited: only the canvas reads it. Longhand on purpose: the CSS minifier folds a
     shorthand next to animation-timeline into one declaration Chrome rejects. */
  @property --terrain-progress {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .terrain {
        animation-name: terrain-progress;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% entry 100%;
      }
    }
  }
  /* The playhead crosses the sentence (0 to 1) over most of the way in, then runs off the edge:
     2.6 is FINISHED in terrain.ts, the still picture's value, so the last frame matches it. */
  @keyframes terrain-progress {
    0% { --terrain-progress: 0; }
    75% { --terrain-progress: 1; }
    100% { --terrain-progress: 2.6; }
  }
  .statement { display: grid; gap: 20px; }
  .email {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    min-height: 44px;
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.375rem);
    font-weight: 650;
    overflow-wrap: anywhere;
  }
  .profiles { display: flex; flex-wrap: wrap; gap: 4px 24px; padding: 0; list-style: none; }
  .profiles a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 600;
  }

  .form {
    position: relative;
    display: grid;
    gap: 20px;
    padding: 28px 24px;
  }
  @media (min-width: 768px) { .form { padding: 36px 32px; } }
  .field { display: grid; gap: 8px; }
  .field label { font-weight: 600; }
  .field input,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid var(--field-line);
    border-radius: var(--radius-control);
    background: var(--paper);
    color: var(--ink);
  }
  .field textarea { min-height: 160px; resize: vertical; }
  .field input:focus-visible,
  .field textarea:focus-visible { outline: 3px solid var(--focus); outline-offset: 1px; }
  .field [aria-invalid='true'] { border-color: var(--error); }
  .field-error { color: var(--error); font-size: 0.875rem; }
  .field-error:empty { display: none; }

  /* Off screen rather than display: none, so bots that skip hidden fields still fill it. */
  .honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  /* Never display: none: a live region must stay in the accessibility tree to be announced. */
  .status[data-state='success'] { color: var(--success); font-weight: 600; }
  .status:is([data-state='error'], [data-state='invalid']) { color: var(--error); }

  /* Motion #10: the spinner turns only while sending, and stands still with reduced motion. */
  .spinner {
    display: none;
    width: 1em;
    height: 1em;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
  }
  .form[data-sending] .spinner { display: inline-block; }
  .form[data-sending] button { cursor: progress; }
  @media (prefers-reduced-motion: no-preference) {
    .form[data-sending] .spinner { animation: spin 0.8s linear infinite; }
  }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
