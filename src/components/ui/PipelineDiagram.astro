---
// A real system diagram drawn from project data (02 §17): an ordered list of stages, read in order
// by screen readers, shown as a column of chips. Router stages list their branches as a nested list.
interface Stage {
  id: string;
  label: string;
  tech?: string;
  detail?: string;
  options?: { label: string; tech?: string }[];
}
interface Props {
  stages: Stage[];
  /** Short description of the system, used as the figure caption. */
  label: string;
}
const { stages, label } = Astro.props;
---
<figure class="pipeline">
  <ol>
    {stages.map((stage) => (
      <li>
        <span class="stage-label">{stage.label}</span>{' '}
        {stage.tech && <span class="stage-tech id" translate="no">{stage.tech}</span>}{' '}
        {stage.detail && <span class="stage-detail t-small">{stage.detail}</span>}
        {stage.options && (
          <ul class="stage-options">
            {stage.options.map((option) => (
              <li>
                {option.label}
                {option.tech && <span class="id" translate="no"> {option.tech}</span>}
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ol>
  <figcaption class="t-small t-muted">{label}</figcaption>
</figure>

<style>
  .pipeline { margin: 0; }
  ol {
    display: flex;
    flex-direction: column;
    padding: 0;
    list-style: none;
  }
  ol > li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 16px;
    border-radius: var(--radius-control);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--hair);
  }
  /* A connector between stages, so they read as one flow rather than separate boxes. */
  ol > li:not(:last-child) { margin-bottom: 26px; position: relative; }
  ol > li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 23px;
    bottom: -26px;
    width: 2px;
    height: 26px;
    background: var(--field-line);
    opacity: 0.6;
  }
  .stage-label { font-weight: 650; font-size: 0.9375rem; line-height: 1.3; }
  .stage-tech { color: var(--muted); font-size: 0.8125rem; }
  .stage-detail { color: var(--muted); }
  .stage-options {
    display: grid;
    gap: 2px;
    margin-top: 6px;
    padding: 6px 0 0;
    border-top: 1px solid var(--hair);
    list-style: none;
    font-size: 0.875rem;
  }
  .stage-options .id { color: var(--muted); }
  figcaption { margin-top: 10px; }
</style>
