---
interface Metric {
  value: string;
  label: string;
  method?: string;
}
interface Props {
  metrics: Metric[];
}
const { metrics } = Astro.props;
// When every number was measured the same way, the method is said once, under them all.
const shared = metrics.every((m) => m.method && m.method === metrics[0].method) ? metrics[0].method : undefined;
---
<dl class="metrics">
  {metrics.map((metric) => (
    <div class="metric">
      <dt>{metric.label}</dt>
      <dd class="t-metric"><span class="mark draw">{metric.value}</span></dd>
      {!shared && metric.method && <dd class="t-small t-muted">{metric.method}</dd>}
    </div>
  ))}
</dl>
{shared && <p class="method t-small t-muted">{shared[0].toUpperCase() + shared.slice(1)}</p>}

<style>
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 240px));
    gap: 20px;
    margin: 0;
  }
  .metric { display: flex; flex-direction: column; gap: 4px; }
  /* Number first visually; the label stays first in the markup so dt precedes dd. */
  .metric dt { order: 2; font-weight: 600; }
  .metric .t-metric { order: 1; }
  .metric dd { margin: 0; order: 3; }
  .method { margin-top: 14px; }

  /* The highlighter draws as the number scrolls in, and is done by the time it is fully on
     screen (02 §10 #6), so a number visible on load is never left half marked. Longhand on purpose:
     the CSS minifier folds a shorthand with animation-timeline into one Chrome drops. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .draw {
        animation-name: mark-draw;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% entry 100%;
      }
    }
  }
  @keyframes mark-draw {
    from { background-size: 0% 0.22em; }
    to { background-size: 100% 0.22em; }
  }
</style>
