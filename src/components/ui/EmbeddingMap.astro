---
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { DOMAIN_LABELS } from '../../lib/content';
import { getMap } from '../../lib/map';
import posterLight from '../../assets/map/poster-light.png';
import posterDark from '../../assets/map/poster-dark.png';
import { INITIAL_POSE, project } from '../../scripts/embedding-map/layout';

interface Props {
  /** Set on the one page where the poster is the LCP candidate (02 §14). */
  priority?: boolean;
}
const { priority = false } = Astro.props;

// The map is built from the content by build.py (02 §8b). Until it runs again, a new project is
// simply not on the map yet; the build says so instead of failing.
const { missing, unknown, ...clientData } = await getMap();
if (missing.length || unknown.length) {
  console.warn(
    `src/data/embedding-map.json is out of date. Not on the map yet: ${missing.join(', ') || 'none'}. No longer in the content: ${unknown.join(', ') || 'none'}. Run python -I tools/embedding-map/build.py, then node tools/embedding-map/poster.mjs.`,
  );
}

// Every project has a label at the pose the canvas starts in. Featured labels show over the poster;
// pressing a legend field shows every label in that field instead (02 §8b).
const labels = clientData.projects.map((p, i) => {
  const point = project(p.xyz, INITIAL_POSE, { width: 1000, height: 1000 });
  // Featured projects go by their short names; others keep the full title, so "(Coursera course)"
  // still tells the two movie recommenders apart.
  const text = p.featured ? p.title.replace(/\s*\(.*\)$/, '') : p.title;
  return { i, domain: p.domain, featured: p.featured, text, left: point.x / 10, top: point.y / 10 };
});

// The three fields (02 §8b). A project outside them is a gray point with no entry: every project
// here is software, so that is no field to press (owner's request, 2026-10-25).
const fields = ['llm-voice', 'vision-audio', 'ml-data'] as const;
const widths = [480, 720, 1000];
const sizes = '(min-width: 1280px) 520px, (min-width: 1024px) 40vw, (min-width: 768px) 70vw, 100vw';
const [lightAvif, lightWebp, darkAvif, darkWebp] = await Promise.all([
  getImage({ src: posterLight, widths, format: 'avif' }),
  getImage({ src: posterLight, widths, format: 'webp' }),
  getImage({ src: posterDark, widths, format: 'avif' }),
  getImage({ src: posterDark, widths, format: 'webp' }),
]);
---
<figure class="map" data-animating="false">
  <div class="map-stage">
    <picture>
      <source media="(prefers-color-scheme: dark)" type="image/avif" srcset={darkAvif.srcSet.attribute} sizes={sizes} />
      <source media="(prefers-color-scheme: dark)" type="image/webp" srcset={darkWebp.srcSet.attribute} sizes={sizes} />
      <source type="image/avif" srcset={lightAvif.srcSet.attribute} sizes={sizes} />
      <img
        src={lightWebp.src}
        srcset={lightWebp.srcSet.attribute}
        sizes={sizes}
        width="1000"
        height="1000"
        alt={`Map of ${clientData.projects.length} projects and the tools they use, grouped by field`}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding={priority ? 'sync' : 'async'}
      />
    </picture>
    <canvas aria-hidden="true"></canvas>
    <div class="map-labels" aria-hidden="true">
      {/* On the poster nothing dims, so a pressed field rings its own points (audit, 2026-10-25). */}
      {labels.map((l) => (
        <span
          class="map-pin"
          data-domain={l.domain}
          style={`left:${l.left.toFixed(2)}%;top:${l.top.toFixed(2)}%;--pin:var(--field-${l.domain})`}
        />
      ))}
      {labels.map((l) => (
        <span
          class="map-label"
          data-index={l.i}
          data-domain={l.domain}
          data-featured={String(l.featured)}
          style={`left:${l.left.toFixed(2)}%;top:${l.top.toFixed(2)}%`}
          class:list={{ 'is-left': l.left > 62 }}
        >
          {l.text}
        </span>
      ))}
      <span class="map-label is-hover" hidden></span>
    </div>
    <!-- The hero's one switch for its lasting motion, shown wherever JavaScript runs (mount.ts): the
         role line cycles and the live map turns slowly until it pauses them (WCAG 2.2.2). -->
    <button type="button" class="map-turn" hidden data-playing="true" aria-label="Pause the animation">
      <span class="when-playing"><Icon name="pause" /></span>
      <span class="when-paused"><Icon name="play" /></span>
    </button>
    <span class="map-probe" aria-hidden="true"></span>
  </div>
  <div class="map-legend" role="group" aria-label="Highlight a field on the map">
    {fields.map((f) => (
      <button type="button" aria-pressed="false" data-domain={f} style={`--swatch: var(--field-${f})`}>
        <span class="swatch" aria-hidden="true"></span>{DOMAIN_LABELS[f]}
      </button>
    ))}
  </div>
  <figcaption class="t-small t-muted">
    {clientData.projects.length} projects, placed by embedding each description with{' '}
    <span class="id" translate="no">all-MiniLM-L6-v2</span> and reducing to 3D with PCA. Press a field to
    label its projects.{' '}
    <a href="/#archive">Browse all projects</a>
  </figcaption>
  <script is:inline id="map-data" type="application/json" set:html={JSON.stringify(clientData).replace(/</g, '\\u003c')} />
</figure>

<script>
  import { mountEmbeddingMap } from '../../scripts/embedding-map/mount';
  document.querySelectorAll<HTMLElement>('figure.map').forEach(mountEmbeddingMap);
</script>

<style>
  .map { margin: 0; }
  .map-stage {
    position: relative;
    aspect-ratio: 1;
  }
  .map-stage img,
  .map-stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  canvas {
    opacity: 0;
    touch-action: pan-y;
    cursor: grab;
  }
  .map.is-live canvas { opacity: 1; }
  .map.is-live img { visibility: hidden; }

  .map-labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .map-label {
    position: absolute;
    translate: 14px -50%;
    padding: 2px 8px;
    border-radius: var(--radius-small);
    background: color-mix(in oklab, var(--paper) 82%, transparent);
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
    /* Long titles wrap. A max-content width (not shrink-to-fit) keeps the size independent of
       where the label sits, which settleLabels relies on. */
    width: max-content;
    max-width: min(20rem, 70%);
  }
  .map-label.is-left { translate: calc(-100% - 14px) -50%; }
  /* Below 1024px the map is the poster, at most 560px wide: smaller labels stay nearer their points. */
  @media (max-width: 1023px) {
    .map-label { padding: 1px 6px; font-size: 0.75rem; max-width: min(14rem, 60%); }
  }
  .map-pin {
    position: absolute;
    display: none;
    width: 14px;
    height: 14px;
    translate: -50% -50%;
    border: 2px solid var(--pin);
    border-radius: 50%;
  }
  .map:not(.is-live)[data-highlight='llm-voice'] .map-pin[data-domain='llm-voice'],
  .map:not(.is-live)[data-highlight='vision-audio'] .map-pin[data-domain='vision-audio'],
  .map:not(.is-live)[data-highlight='ml-data'] .map-pin[data-domain='ml-data'] { display: block; }
  .map-label.is-hover { z-index: 1; box-shadow: var(--shadow); }
  .map-label[data-featured='false'] { display: none; }
  .map[data-highlight] .map-label[data-index] { display: none; }
  .map[data-highlight='llm-voice'] .map-label[data-domain='llm-voice'],
  .map[data-highlight='vision-audio'] .map-label[data-domain='vision-audio'],
  .map[data-highlight='ml-data'] .map-label[data-domain='ml-data'] { display: block; }
  .map-probe { position: absolute; width: 0; height: 0; overflow: hidden; }

  /* A small round control in the map's corner, like the zoom badge on project pictures. */
  .map-turn {
    position: absolute;
    right: 8px;
    bottom: 8px;
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: color-mix(in oklab, var(--surface) 88%, transparent);
    box-shadow: inset 0 0 0 1px var(--hair);
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s;
  }
  .map-turn[hidden] { display: none; }
  .map-turn:hover { color: var(--ink); background: var(--surface); }
  .map-turn :global(.icon) { width: 18px; height: 18px; }
  .map-turn > span { display: inline-flex; }
  .map-turn[data-playing='true'] .when-paused,
  .map-turn[data-playing='false'] .when-playing { display: none; }

  /* Outlined buttons, so the fields read as controls, not a caption. Each is as wide as its name,
     and they wrap: with three fields, a two-column grid stretched one and left one alone. */
  .map-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  /* Secondary controls: 36px is above the WCAG 2.2 target-size minimum (24px). */
  .map-legend button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding-inline: 10px 12px;
    border: 0;
    border-radius: var(--radius-control);
    background: none;
    box-shadow: inset 0 0 0 1px var(--hair);
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .map-legend button:hover { background: var(--tint); color: var(--ink); }
  .map-legend button[aria-pressed='true'] { background: var(--tint); color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--link); }
  .swatch {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--swatch);
  }
  figcaption { margin-top: 10px; max-width: 60ch; }
  figcaption .id { white-space: nowrap; }
</style>
